package com.example;

import com.mojang.authlib.GameProfile;
import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
import net.minecraft.client.Minecraft;
import net.minecraft.client.multiplayer.ClientLevel;
import net.minecraft.client.player.LocalPlayer;
import net.minecraft.client.player.RemotePlayer;
import net.minecraft.core.particles.ParticleTypes;
import net.minecraft.world.InteractionHand;
import net.minecraft.world.effect.MobEffects;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.phys.Vec3;

import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;
import java.util.Random;
import java.util.UUID;

public final class AcidHallucinationManager {
    private static final List<Hallucination> HALLUCINATIONS = new ArrayList<>();
    private static final Random RANDOM = new Random();
    private static boolean registered = false;
    private static boolean wasActive = false;
    private static int nextEntityId = -610000;
    private static int tick = 0;

    private AcidHallucinationManager() {
    }

    public static void register() {
        if (registered) {
            return;
        }
        registered = true;
        ClientTickEvents.END_CLIENT_TICK.register(client -> clientTick());
        System.out.println("[Narcotix] Registered Acid hallucination manager v120.");
    }

    private static void clientTick() {
        Minecraft client = Minecraft.getInstance();
        LocalPlayer player = client.player;
        ClientLevel level = client.level;
        tick++;

        if (player == null || level == null) {
            clearAll();
            wasActive = false;
            return;
        }

        boolean active = hasAcidVisualEffect(player);
        if (!active) {
            if (wasActive || !HALLUCINATIONS.isEmpty()) {
                clearAll();
                System.out.println("[Narcotix] Acid hallucinations cleared.");
            }
            wasActive = false;
            return;
        }

        if (!wasActive) {
            System.out.println("[Narcotix] Acid hallucinations active; spawning visible fake people.");
            clearAll();
            spawnInitial(level, player);
        }
        wasActive = true;

        while (HALLUCINATIONS.size() < 6 && RANDOM.nextInt(50) == 0) {
            spawnOne(level, player, HALLUCINATIONS.size());
        }

        Iterator<Hallucination> iterator = HALLUCINATIONS.iterator();
        while (iterator.hasNext()) {
            Hallucination h = iterator.next();
            if (h.fake.isRemoved() || h.life-- <= 0) {
                safeRemove(h.fake);
                iterator.remove();
                continue;
            }
            updateHallucination(level, player, h);
        }
    }

    private static boolean hasAcidVisualEffect(LocalPlayer player) {
        if (player.hasEffect(MobEffects.NAUSEA)) {
            return true;
        }
        try {
            return player.hasEffect(NarcotixEffects.ACID);
        } catch (Throwable ignored) {
            return false;
        }
    }

    private static void spawnInitial(ClientLevel level, LocalPlayer player) {
        for (int i = 0; i < 6; i++) {
            spawnOne(level, player, i);
        }
    }

    private static void spawnOne(ClientLevel level, LocalPlayer player, int slot) {
        try {
            GameProfile profile = new GameProfile(UUID.randomUUID(), randomName(slot));
            RemotePlayer fake = new RemotePlayer(level, profile);
            fake.setId(nextEntityId--);
            fake.setNoGravity(true);
            fake.setInvisible(false);
            fake.setSilent(true);

            if (NarcotixMod.CIGARETTE != null) {
                fake.setItemInHand(InteractionHand.MAIN_HAND, new ItemStack(NarcotixMod.CIGARETTE));
            }

            Hallucination h = new Hallucination(fake, 20 * (16 + RANDOM.nextInt(16)), slot);
            placeHallucination(player, h, true);
            level.addEntity(fake);
            HALLUCINATIONS.add(h);
            System.out.println("[Narcotix] Spawned visible acid hallucination at " + fake.getX() + ", " + fake.getY() + ", " + fake.getZ());
        } catch (Throwable t) {
            System.out.println("[Narcotix] Failed to spawn acid hallucination: " + t);
        }
    }

    private static String randomName(int slot) {
        String[] names = new String[] { "Steve", "Alex", "Herobrine", "Stranger", "Smoke", "Ghost" };
        return names[Math.abs(slot) % names.length] + RANDOM.nextInt(1000);
    }

    private static void updateHallucination(ClientLevel level, LocalPlayer player, Hallucination h) {
        placeHallucination(player, h, false);
        facePlayer(player, h.fake);

        if (tick % 4 == 0) {
            double px = h.fake.getX();
            double py = h.fake.getY() + 1.55D;
            double pz = h.fake.getZ();
            Vec3 look = h.fake.getLookAngle();
            level.addParticle(ParticleTypes.CAMPFIRE_COSY_SMOKE,
                    px + look.x * 0.35D,
                    py,
                    pz + look.z * 0.35D,
                    0.0D,
                    0.018D,
                    0.0D);
        }
    }

    private static void placeHallucination(LocalPlayer player, Hallucination h, boolean firstPlace) {
        float baseYaw = player.getYRot();
        double angleDeg = baseYaw + h.angleOffset + Math.sin((tick + h.phase) * 0.025D) * 20.0D;
        double angle = Math.toRadians(angleDeg);

        double radius = h.radius + Math.sin((tick + h.phase) * 0.035D) * 0.75D;
        double walk = Math.sin((tick + h.phase) * 0.05D) * 0.65D;

        double x = player.getX() - Math.sin(angle) * radius + Math.cos(angle) * walk;
        double z = player.getZ() + Math.cos(angle) * radius + Math.sin(angle) * walk;
        double y = player.getY();

        // Keep them at roughly the player's height so they stay visible instead of drifting underground.
        h.fake.setPos(x, y, z);
        h.fake.setOnGround(true);
        if (firstPlace) {
            facePlayer(player, h.fake);
        }
    }

    private static void facePlayer(LocalPlayer player, RemotePlayer fake) {
        double dx = player.getX() - fake.getX();
        double dz = player.getZ() - fake.getZ();
        float yaw = (float)(Math.toDegrees(Math.atan2(dz, dx)) - 90.0D);
        fake.setYRot(yaw);
        fake.setYHeadRot(yaw);
        fake.setYBodyRot(yaw);
        fake.setXRot(0.0F);
    }

    private static void clearAll() {
        for (Hallucination h : HALLUCINATIONS) {
            safeRemove(h.fake);
        }
        HALLUCINATIONS.clear();
    }

    private static void safeRemove(Entity entity) {
        try {
            entity.discard();
        } catch (Throwable ignored) {
            try {
                entity.remove(Entity.RemovalReason.DISCARDED);
            } catch (Throwable ignoredAgain) {
            }
        }
    }

    private static final class Hallucination {
        final RemotePlayer fake;
        int life;
        final double radius;
        final double angleOffset;
        final int phase;

        Hallucination(RemotePlayer fake, int life, int slot) {
            this.fake = fake;
            this.life = life;
            this.radius = 4.0D + RANDOM.nextDouble() * 3.0D;
            this.angleOffset = -55.0D + slot * 22.0D + RANDOM.nextDouble() * 18.0D;
            this.phase = RANDOM.nextInt(10000);
        }
    }
}