package com.example;

import com.mojang.authlib.GameProfile;
import java.lang.reflect.Field;
import java.lang.reflect.Method;
import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;
import java.util.Random;
import java.util.UUID;
import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
import net.minecraft.client.Minecraft;
import net.minecraft.client.multiplayer.ClientLevel;
import net.minecraft.client.player.LocalPlayer;
import net.minecraft.client.player.RemotePlayer;
import net.minecraft.core.particles.ParticleTypes;
import net.minecraft.world.effect.MobEffects;
import net.minecraft.world.entity.EquipmentSlot;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.Items;
import net.minecraft.world.phys.Vec3;

public final class AcidHallucinationManager {
    private static final Random RANDOM = new Random();
    private static final List<Hallucination> HALLUCINATIONS = new ArrayList<>();
    private static boolean wasActive = false;
    private static int spawnCooldown = 0;
    private static int nextEntityId = -100000;

    private AcidHallucinationManager() {}

    public static void register() {
        ClientTickEvents.END_CLIENT_TICK.register(client -> tick(client));
        System.out.println("[Narcotix] Registered Acid hallucination manager v135 walking animation restore.");
    }

    public static boolean isHallucination(Object entity) {
        for (Hallucination h : HALLUCINATIONS) {
            if (h.fake == entity) return true;
        }
        return false;
    }

    private static void tick(Minecraft client) {
        LocalPlayer player = client.player;
        ClientLevel level = client.level;
        if (player == null || level == null) {
            clear(level);
            wasActive = false;
            return;
        }

        boolean active = hasAcidVisuals(player);
        if (!active) {
            if (wasActive || !HALLUCINATIONS.isEmpty()) {
                clear(level);
                System.out.println("[Narcotix] Acid hallucinations cleared.");
            }
            wasActive = false;
            return;
        }

        if (!wasActive) {
            System.out.println("[Narcotix] Acid hallucinations active; spawning walking fake people.");
            spawnCooldown = 0;
        }
        wasActive = true;

        if (spawnCooldown-- <= 0 && HALLUCINATIONS.size() < 6) {
            spawnHallucination(client, player, level, HALLUCINATIONS.size());
            spawnCooldown = 25 + RANDOM.nextInt(35);
        }

        Iterator<Hallucination> it = HALLUCINATIONS.iterator();
        while (it.hasNext()) {
            Hallucination h = it.next();
            h.life--;
            if (h.life <= 0 || h.fake.isRemoved()) {
                safeRemove(level, h.fake);
                it.remove();
                continue;
            }
            updateHallucination(level, player, h);
        }
    }

    private static boolean hasAcidVisuals(LocalPlayer player) {
        if (player.hasEffect(MobEffects.NAUSEA)) return true;
        try {
            return player.hasEffect(NarcotixEffects.ACID);
        } catch (Throwable ignored) {
            return false;
        }
    }

    private static void spawnHallucination(Minecraft client, LocalPlayer player, ClientLevel level, int slot) {
        try {
            GameProfile profile = new GameProfile(UUID.nameUUIDFromBytes(("narcotix-acid-hallucination-" + System.nanoTime()).getBytes()), "Steve");
            RemotePlayer fake = new RemotePlayer(level, profile);
            fake.setInvisible(false);
            fake.noPhysics = false;
            fake.setItemSlot(EquipmentSlot.MAINHAND, cigaretteStack());

            double angle = Math.toRadians(player.getYRot()) + (RANDOM.nextDouble() - 0.5D) * 1.8D;
            double dist = 4.0D + RANDOM.nextDouble() * 3.5D;
            double x = player.getX() - Math.sin(angle) * dist;
            double z = player.getZ() + Math.cos(angle) * dist;
            double y = player.getY();

            fake.setPos(x, y, z);
            fake.xo = x;
            fake.yo = y;
            fake.zo = z;
            facePlayer(fake, player);
            fake.setOnGround(true);
            fake.setShiftKeyDown(false);
            fake.setSprinting(false);
            fake.setNoGravity(false);

            int id = nextEntityId--;
            fake.setId(id);
            level.addEntity(fake);
            HALLUCINATIONS.add(new Hallucination(fake, 20 * 40 + RANDOM.nextInt(20 * 20), slot, angle));
            System.out.println("[Narcotix] Spawned walking acid hallucination at " + x + ", " + y + ", " + z);
        } catch (Throwable t) {
            System.out.println("[Narcotix] Failed to spawn acid hallucination: " + t.getClass().getSimpleName() + ": " + t.getMessage());
        }
    }

    private static ItemStack cigaretteStack() {
        try {
            return new ItemStack(NarcotixMod.CIGARETTE);
        } catch (Throwable ignored) {
            return new ItemStack(Items.STICK);
        }
    }

    private static void updateHallucination(ClientLevel level, LocalPlayer player, Hallucination h) {
        h.age++;

        double orbit = h.baseAngle + Math.sin(h.age * 0.035D + h.slot) * 0.65D;
        double dist = 4.6D + Math.sin(h.age * 0.021D + h.slot * 2.0D) * 1.25D;
        double targetX = player.getX() - Math.sin(orbit) * dist;
        double targetZ = player.getZ() + Math.cos(orbit) * dist;
        double targetY = player.getY();

        double dx = targetX - h.fake.getX();
        double dz = targetZ - h.fake.getZ();
        double step = 0.035D;
        double moveX = clamp(dx, -step, step);
        double moveZ = clamp(dz, -step, step);
        double speed = Math.sqrt(moveX * moveX + moveZ * moveZ);

        h.fake.xo = h.fake.getX();
        h.fake.yo = h.fake.getY();
        h.fake.zo = h.fake.getZ();
        h.fake.setPos(h.fake.getX() + moveX, targetY, h.fake.getZ() + moveZ);
        h.fake.setDeltaMovement(moveX, 0.0D, moveZ);
        h.fake.setOnGround(true);
        h.fake.setSprinting(false);
        h.fake.setShiftKeyDown(false);
        h.fake.setItemSlot(EquipmentSlot.MAINHAND, cigaretteStack());
        facePlayer(h.fake, player);
        tryUpdateWalkAnimation(h.fake, speed);

        // Do not force vanilla use-item state. That breaks the nice organic movement and makes the
        // hallucinations hold the cigarette image up to their face. Keep smoking as mouth smoke only.
        if (h.age % 3 == 0) {
            Vec3 mouth = mouthPoint(h.fake);
            level.addParticle(ParticleTypes.CAMPFIRE_COSY_SMOKE, mouth.x, mouth.y, mouth.z, 0.0D, 0.02D, 0.0D);
        }
        if (h.age % 10 == 0) {
            Vec3 mouth = mouthPoint(h.fake);
            level.addParticle(ParticleTypes.SMOKE, mouth.x, mouth.y, mouth.z, (RANDOM.nextDouble() - 0.5D) * 0.012D, 0.03D, (RANDOM.nextDouble() - 0.5D) * 0.012D);
        }
    }

    private static Vec3 mouthPoint(RemotePlayer fake) {
        double yaw = Math.toRadians(fake.getYRot());
        double forwardX = -Math.sin(yaw);
        double forwardZ = Math.cos(yaw);
        double sideX = Math.cos(yaw);
        double sideZ = Math.sin(yaw);
        return new Vec3(
                fake.getX() + forwardX * 0.28D + sideX * 0.18D,
                fake.getY() + 1.58D,
                fake.getZ() + forwardZ * 0.28D + sideZ * 0.18D
        );
    }

    private static void facePlayer(RemotePlayer fake, LocalPlayer player) {
        double dx = player.getX() - fake.getX();
        double dz = player.getZ() - fake.getZ();
        float yaw = (float)(Math.toDegrees(Math.atan2(dz, dx)) - 90.0D);
        fake.setYRot(yaw);
        fake.setYHeadRot(yaw);
        fake.yHeadRotO = yaw;
        fake.yBodyRot = yaw;
        fake.yBodyRotO = yaw;
        fake.setXRot(0.0F);
    }

    private static double clamp(double value, double min, double max) {
        return Math.max(min, Math.min(max, value));
    }

    private static void tryUpdateWalkAnimation(RemotePlayer fake, double speed) {
        float walkSpeed = (float)Math.min(1.0D, speed * 18.0D);

        // Newer Minecraft versions store limb animation in a WalkAnimationState object.
        // Keep this reflective so the mod stays mapping-tolerant.
        Object walkAnimation = getObject(fake, "walkAnimation");
        if (walkAnimation != null) {
            invokeWalkAnimationUpdate(walkAnimation, walkSpeed);
        }

        // Older/intermediate mappings sometimes expose float fields instead. These are harmless if absent.
        addFloat(fake, "walkAnimationPosition", walkSpeed * 0.65F);
        setFloat(fake, "walkAnimationSpeed", walkSpeed);
        addFloat(fake, "animationPosition", walkSpeed * 0.65F);
        setFloat(fake, "animationSpeed", walkSpeed);
    }

    private static void invokeWalkAnimationUpdate(Object walkAnimation, float speed) {
        try {
            Method update = null;
            for (Method m : walkAnimation.getClass().getDeclaredMethods()) {
                if (!m.getName().equals("update")) continue;
                Class<?>[] params = m.getParameterTypes();
                if (params.length == 2 && params[0] == float.class && params[1] == float.class) {
                    update = m;
                    break;
                }
            }
            if (update != null) {
                update.setAccessible(true);
                update.invoke(walkAnimation, speed, 0.45F);
            }
        } catch (Throwable ignored) {
        }
    }

    private static Object getObject(Object obj, String name) {
        try {
            Field f = findField(obj.getClass(), name);
            if (f == null) return null;
            f.setAccessible(true);
            return f.get(obj);
        } catch (Throwable ignored) {
            return null;
        }
    }

    private static float getFloat(Object obj, String name) {
        try {
            Field f = findField(obj.getClass(), name);
            if (f == null) return 0.0F;
            f.setAccessible(true);
            return f.getFloat(obj);
        } catch (Throwable ignored) {
            return 0.0F;
        }
    }

    private static void setFloat(Object obj, String name, float value) {
        try {
            Field f = findField(obj.getClass(), name);
            if (f == null) return;
            f.setAccessible(true);
            f.setFloat(obj, value);
        } catch (Throwable ignored) {
        }
    }

    private static void addFloat(Object obj, String name, float amount) {
        setFloat(obj, name, getFloat(obj, name) + amount);
    }

    private static Field findField(Class<?> cls, String name) {
        Class<?> c = cls;
        while (c != null) {
            try {
                return c.getDeclaredField(name);
            } catch (NoSuchFieldException ignored) {
                c = c.getSuperclass();
            }
        }
        return null;
    }

    private static void clear(ClientLevel level) {
        if (level != null) {
            for (Hallucination h : HALLUCINATIONS) {
                safeRemove(level, h.fake);
            }
        }
        HALLUCINATIONS.clear();
    }

    private static void safeRemove(ClientLevel level, RemotePlayer fake) {
        try {
            fake.discard();
        } catch (Throwable ignored) {
            try { fake.remove(net.minecraft.world.entity.Entity.RemovalReason.DISCARDED); } catch (Throwable ignored2) {}
        }
    }

    private static final class Hallucination {
        final RemotePlayer fake;
        int life;
        final int slot;
        final double baseAngle;
        int age;

        Hallucination(RemotePlayer fake, int life, int slot, double baseAngle) {
            this.fake = fake;
            this.life = life;
            this.slot = slot;
            this.baseAngle = baseAngle;
            this.age = RANDOM.nextInt(80);
        }
    }
}